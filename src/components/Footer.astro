</footer>

<script>
	const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const order = ['auto', 'light', 'dark'] as const;
	const read = () => {
		try {
			return (localStorage.getItem('soajs-theme') as (typeof order)[number]) || 'auto';
		} catch {
			return 'auto';
		}
	};
	const apply = (mode: (typeof order)[number]) => {
		if (mode === 'auto') delete document.documentElement.dataset.theme;
		else document.documentElement.dataset.theme = mode;
		if (btn) btn.textContent = `Theme: ${mode}`;
		try {
			// Keep the Starlight docs theme in sync with the marketing pages.
			localStorage.setItem('soajs-theme', mode);
			localStorage.setItem('starlight-theme', mode === 'auto' ? '' : mode);
		} catch {}
	};
	if (btn) btn.textContent = `Theme: ${read()}`;
	btn?.addEventListener('click', () => apply(order[(order.indexOf(read()) + 1) % order.length]));
</script>
