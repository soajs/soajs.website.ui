---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist on soajs.org.">
	<section class="hero">
		<div class="wrap">
			<p class="eyebrow">404</p>
			<h1>That page moved or never existed.</h1>
			<p class="lead">The documentation now lives on this site under /docs. Older Confluence links are not carried over.</p>
			<div class="actions">
				<a class="btn btn-primary" href="/">Home</a>
				<a class="btn btn-ghost" href="/docs/">Documentation</a>
			</div>
		</div>
	</section>
</Base>
